# Copy this file to `.env` and replace the placeholders with real values.
# Requires PostgreSQL >= 15.

# Pooled (transaction mode) connection used by the app runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Direct/session connection used by Prisma migrations and pg-boss.
DIRECT_URL="postgresql://user:password@localhost:5432/mydb"

# Optional override for background jobs. Defaults to DIRECT_URL.
# pg-boss cannot use a transaction-mode pooler.
JOBS_DATABASE_URL=""

# Transactional email. With BREVO_API_KEY set the worker sends through Brevo
# and EMAIL_OUTBOX_DIR is ignored; without it (dev/test) emails are written to
# the outbox below. Production refuses to start without Brevo configured.
BREVO_API_KEY=""
EMAIL_FROM="hello@your-verified-domain.com"
EMAIL_FROM_NAME="VisitMyLondon"

# Dev/test only: FileEmailSender appends emails to $EMAIL_OUTBOX_DIR/outbox.jsonl.
# Never set in production.
EMAIL_OUTBOX_DIR=".tmp/email-outbox"

# Integration tests. The database name must contain "test".
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/mydb_test"
